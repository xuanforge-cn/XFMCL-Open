<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>Xfmcl.Open</AssemblyName>
    <RootNamespace>XfmclOpen.Desktop</RootNamespace>
    <Version>1.0.0</Version>
    <Product>XFMCL Open</Product>
    <Company>玹砺科技 XUANFORGE</Company>
    <Description>XFMCL Open - 跨平台开源 Minecraft 启动器（离线登录）</Description>
  </PropertyGroup>

  <!-- 发布参数按平台传入 -r，例如 win-x64 / linux-x64 / osx-arm64 -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>en;zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Xfmcl.Open.Core\Xfmcl.Open.Core.csproj" />
    <ProjectReference Include="..\Xfmcl.Open.UI\Xfmcl.Open.UI.csproj" />
  </ItemGroup>

</Project>
